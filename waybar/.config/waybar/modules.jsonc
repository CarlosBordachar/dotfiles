{
    "custom/launcher": {
        "format": "",
        "on-click": "fuzzel",
        "on-click-right": "~/.config/scripts/fuzzel-powermenu.sh",
        "tooltip": false
    },
    "niri/workspaces": {
        "all-outputs": false,
        "hide-empty": true,
        "format": "{value}",
    },
    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "max-length": 40,
        "player-icons": {
            "default": "⏸",
            "mpv": "🎵"
        },
        "status-icons": {
            "paused": "▶" 
        },
        // "ignored-players": ["firefox"]
    },
    "niri/window": {
        "format": "{title}",
        "max-length": 70,
        "icon": true,
        "icon-size": 16,
        "separate-outputs": true,
    },

    //
    // SYSTEM
    //
    "temperature": {
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["", "", "", "", ""],
        //"thermal-zone": 0,
        "hwmon-path": ["/sys/class/hwmon/hwmon2/temp1_input"],
        "warning-threshold": 70,
        "critical-threshold": 85,
        "interval": 10,
        "on-click": "~/.config/waybar/scripts/systeminfo.sh"
    },
    "cpu": {
        "format": " {usage}%",
        "max-length": 10,
        "interval": 5,
        "on-click": "~/.config/waybar/scripts/systeminfo.sh"
    },
    "memory": {
        "format": " {}%",
        "max-length": 10,
        "tooltip-format": "Memory: {used}GiB / {total}GiB ({percentage}%)\nSwap: {swapUsed}GiB / {swapTotal}GiB ({swapPercentage}%)",
        "interval": 5,
        "on-click": "~/.config/waybar/scripts/systeminfo.sh"
    },
    "disk": {
        "format": "󰋊 {percentage_used}%",
        "path": "/",
        "tooltip-format": "{path}: {used} / {total} ({percentage_used}%)",
        "interval": 60,
        "on-click": "~/.config/waybar/scripts/systeminfo.sh"
    }, 
    "custom/system": {
        "format": "󰇅",
        "tooltip": false
    },
    // Group Hardware
    "group/hardware": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "children-class": "not-memory",
            "transition-left-to-right": false
        },        
        "modules": [
            //"custom/system",
            "temperature",
            "disk",
            "cpu",
            "memory"
        ]
    },

    "user": {
        "format": "{user}",
        "interval": 60,
        "icon": false
    },

    // KEYBOARD
    "niri/language": {
        "format": " {short}"
    },
    "keyboard-state": {
        "numlock": false,
        "capslock": true,
        "format": {
            "capslock": "󰪛"
        }
        //"format": "{name} {icon}",
        //"format": {
        //    "numlock": "NUM {icon}",
        //    "capslock": "CAPS {icon}"
        //},
        //"format-icons": {
        //    "locked": "",
        //    "unlocked": ""
        //}
    },

    "tray": {
        "icon-size": 13,
        "spacing": 10
    },
    "network": {
        // "interface": "wlp2s0", // (Optional) To force the use of this interface
        "format": "⚠  Disabled",
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀 {ifname} (No IP)",
        "format-disconnected": "󰖪  Disconnected",
        "format-alt": "<span foreground='#8bd5ca'> {bandwidthDownBytes}</span> <span foreground='#ee99a0'> {bandwidthUpBytes}</span>",
        "tooltip": true,
        "tooltip-format": "{ifname}",
        "tooltip-format-wifi": "Network: <big><b>{essid}</b></big>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>",
        "tooltip-format-ethernet": "Network: <big><b>{essid}</b></big>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 3
    },
    "bluetooth": {
        "format": "",
        "format-alt": " {num_connections} {status}",
        "format-disabled": " disabled",
        "format-connected": " {num_connections}",
        "tooltip-format": "Status:\t\t{status}\n{controller_alias}:\t{controller_address}\nConnected:\t{num_connections}",
        "tooltip-format-connected": "Status:\t\t{status}\n{controller_alias}:\t{controller_address}\nConnected:\t{num_connections}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}:\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}:\t{device_address}  {device_battery_percentage}%",
        "on-click-right": "foot bluetui"
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": [ "󰃞", "󰃟", "󰃠" ],
        "on-scroll-down": "brightnessctl -c backlight set 5%-",
        "on-scroll-up": "brightnessctl -c backlight set 5%+",
        "min-length": 6
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " Muted",
        "format-bluetooth": "{icon}  {volume}%",
        "format-bluetooth-muted": "{icon}  Muted",
        "tooltip-format": "{desc} @ {volume}%",
        "on-click-right": "pavucontrol-qt",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%-",
        "scroll-step": 5,
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [ "", "", "" ]
        }
    },
    "pulseaudio#microphone": {
        "format": "{format_source}",
        "rotate": 0,
        "format-source": "",
        "format-source-muted": " Muted",
        "on-click-right": "pavucontrol-qt",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        //"on-click-middle": "volumecontrol.sh -i m",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 5%+",
        "on-scroll-down": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 5%-",
        "tooltip-format": "{format_source} {source_desc} @ {source_volume}%",
        "scroll-step": 5
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 35,
            "critical": 20
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon} {time} @ {power}w",
        "format-icons": [ "󰂃", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹" ],
        "tooltip-format": "Status:\t\t{timeTo}\nCapacity:\t{capacity}%\nDrawing:\t{power}w\nCycles: \t{cycles}\nHealth: \t{health}%",
        "interval": 5
    },
    "clock": {
        //"format": " {:%a %d %b  %I:%M %p}", //12 hour format
        "format": " {:%H:%M}", //24 hour format
        "format-alt": " {:%d/%m/%Y  %H:%M}", //24 hour format
        "timezones": [
            "America/Argentina/Buenos_Aires",
            "America/Los_Angeles",
            "America/Chicago",
            "Europe/Paris",
            "UTC"
        ],
        "timezone-tooltip-format": "{:%H:%M %Z}",
        "tooltip": true,
        //"tooltip-format": "{tz_list}",
        "tooltip-format": "<tt>{calendar}</tt>\n\n<span color='#a5adcb'>Timezones</span>\n<tt><span color='#5b6078'>{tz_list}</span></tt>",
        "interval": 10,
        "rotate": 0,
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#a5adcb'><b>{}</b></span>",
                "weekdays": "<span color='#a5adcb'><b>{}</b></span>",
                "today": "<span color='#b7bdf8'><b>{}</b></span>",
                "days": "<span color='#5b6078'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "custom/power": {
        "format" : "",
        "tooltip": false,
        "rotate": 0,
        //"on-click": "niri msg action quit",
        //"on-click-middle": "killall -SIGUSR2 waybar",
        //"on-click-right": "niri msg action power-off-monitors"
        "on-click": "~/.config/waybar/scripts/powermodule.sh",
        "on-click-middle": "~/.config/waybar/scripts/powermodule.sh -r",
        "on-click-right": "~/.config/waybar/scripts/powermodule.sh -m"
    }
}
