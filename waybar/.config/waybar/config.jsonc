{
    "layer": "top",
    "position": "top",
    "mode": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "reload_style_on_change": true,
    "height": 0,
    "margin-left": 15,
    "margin-right": 15,
    "margin-top": 7,
    "margin-bottom": 0,
    "spacing": 0,
    "modules-left": [
        "custom/launcher",
        "niri/workspaces",
        "mpris"
    ],
    "modules-center": [
        "niri/window"
    ],
    "modules-right": [
        "tray",
        "niri/language",
        "network",
        "backlight",
        "pulseaudio",
        "pulseaudio#microphone",
        "battery",
        "clock",
        "custom/power",
    ],
    "custom/launcher": {
        "format": "",
        "on-click": "fuzzel",
        "on-click-right": "niri msg action show-hotkey-overlay",
        "tooltip": false
    },
    "niri/workspaces": {
        "all-outputs": false,
        "hide-empty": true,
        "format": "{value}",
    },
    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "max-length": 40,
        "player-icons": {
            "default": "⏸",
            "mpv": "🎵"
        },
        "status-icons": {
            "paused": "▶" 
        },
        // "ignored-players": ["firefox"]
    },
    "niri/window": {
        "format": "{title}",
        "max-length": 70,
        "icon": true,
        "icon-size": 16,
        "separate-outputs": true,
    },
    "niri/language": {
        "format": "{short}",
    },
    "tray": {
        "icon-size": 13,
        "spacing": 10
    },
    "network": {
        // "interface": "wlp2s0", // (Optional) To force the use of this interface
        "format": "⚠  Disabled",
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀 {ifname} (No IP)",
        "format-disconnected": "󰖪  Disconnected",
        "format-alt": "<span foreground='#8bd5ca'> {bandwidthDownBytes}</span> <span foreground='#ee99a0'> {bandwidthUpBytes}</span>",
        "tooltip": true,
        "tooltip-format": "Network: <big><b>{essid}</b></big>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 3
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        "on-scroll-down": "brightnessctl -c backlight set 5%-",
        "on-scroll-up": "brightnessctl -c backlight set 5%+",
        "min-length": 6
    },
    "pulseaudio": {
        "tooltip-format": "{desc} @ {volume}%",
        "format": "{icon} {volume}%",
        "format-muted": " Muted",
        "format-bluetooth": "{icon} {volume}%",
        "format-bluetooth-muted": "{icon} Muted",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%-",
        "scroll-step": 5,
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                "",
                "",
                ""
            ]
        }
    },
    "pulseaudio#microphone": {
        "format": "{format_source}",
        "rotate": 0,
        "format-source": "",
        "format-source-muted": " Muted",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        //"on-click-middle": "volumecontrol.sh -i m",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 5%+",
        "on-scroll-down": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 5%-",
        "tooltip-format": "{format_source} {source_desc} @ {source_volume}%",
        "scroll-step": 5
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{time} {icon}",
        //"format-icons": ["", "", "", "", ""],
        "format-icons": [
            "󰂃",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    },
    "clock": {
        //"format": " {:%a %d %b  %I:%M %p}", //12 hour format
        "format": " {:%H:%M}", //24 hour format
        "format-alt": " {:%d/%m/%Y  %H:%M}", //24 hour format
        "timezones": [
            "America/Argentina/Buenos_Aires",
            "America/Los_Angeles",
            "America/Chicago",
            "Europe/Paris",
            "UTC"
        ],
        "timezone-tooltip-format": "{:%H:%M %Z}",
        "tooltip": true,
        //"tooltip-format": "{tz_list}",
        "tooltip-format": "<tt>{calendar}</tt>\n\n<span color='#a5adcb'>Timezones</span>\n<tt><span color='#5b6078'>{tz_list}</span></tt>",
        "interval": 10,
        "rotate": 0,
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#a5adcb'><b>{}</b></span>",
                "weekdays": "<span color='#a5adcb'><b>{}</b></span>",
                "today": "<span color='#b7bdf8'><b>{}</b></span>",
                "days": "<span color='#5b6078'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "custom/power": {
        "format" : "",
        "tooltip": false,
        "rotate": 0,
        "on-click": "niri msg action quit",
        "on-click-middle": "killall -SIGUSR2 waybar",
        "on-click-right": "niri msg action power-off-monitors"
    },
}
