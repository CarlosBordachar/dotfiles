{
    "name": "principal",
    "layer": "top",
    "position": "top",
    "mode": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "reload_style_on_change": true,
    "fixed-center": true,
    "height": 0,
    "margin-left": 0,
    "margin-right": 0,
    "margin-top": 0,
    "margin-bottom": 0,
    "spacing": 0,

    // Modules distribution
    "modules-left": [
        "custom/launcher",
        "niri/workspaces",
        "mpris"
    ],
    "modules-center": [
        "niri/window"
    ],
    "modules-right": [
        //"temperature",
        "group/hardware",
        //"user",
        "niri/language",
        "keyboard-state",
        "tray",
        "network",
        "bluetooth",
        "backlight",
        "pulseaudio",
        "pulseaudio#microphone",
        "battery",
        "clock",
        "custom/power"
    ],

    // Load Modules
    "include": ["./modules.jsonc"]
}
